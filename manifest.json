{
    "id": "lan-sync",
    "name": "LAN Sync",
    "version": "0.4.6",
    "author": "DJLegends",
    "description": "Keeps two Project Σ installs in step over your network via automatic LAN discovery, manual IP, or QR code, with direct SQLite database + media sync and scheduled Auto Sync.",
    "requires": { "api": "2.5" },
    "settings": {
        "deviceName": "",
        "syncCharacters": true,
        "syncChats": true,
        "syncLorebooks": true,
        "syncPersonas": true,
        "syncPresets": true,
        "syncPlaylists": true,
        "syncBackgrounds": true,
        "syncSettings": true,
        "syncConnections": false,
        "syncSecrets": false,
        "mode": "incremental",
        "overwrite": "exact"
    },
    "contributes": ["app.action", "character.action"],
    "client": "client/index.js",
    "style": "client/style.css",
    "server": "server/index.js"
}
